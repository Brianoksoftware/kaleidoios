    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#140824",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prismbloom.game"
    },
    "android": {
      "package": "com.prismbloom.game",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#140824",
